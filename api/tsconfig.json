{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "paths": {
      "@granfondo/database/schema": ["../database/src/schema.ts"],
      "@granfondo/database/types": ["../database/src/types.ts"],
      "@granfondo/database/db-client": ["../database/src/db-client.ts"],
      "@granfondo/database/normalize": ["../database/src/normalize.ts"],
      "@granfondo/utils/distance": ["../utils/src/distance.ts"],
      "@granfondo/utils/category": ["../utils/src/category.ts"]
    }
  },
  "include": ["src"]
}
