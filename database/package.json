{
  "name": "@granfondo/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate-schema": "drizzle-kit generate"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.4"
  },
  "exports": {
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./src/schema.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./db-writer": {
      "types": "./src/db-writer.ts",
      "default": "./src/db-writer.ts"
    },
    "./db-client": {
      "types": "./src/db-client.ts",
      "default": "./src/db-client.ts"
    },
    "./normalize": {
      "types": "./src/normalize.ts",
      "default": "./src/normalize.ts"
    }
  },
  "peerDependencies": {
    "better-sqlite3": "*",
    "drizzle-orm": "*",
    "sql.js": "*"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": { "optional": true },
    "sql.js": { "optional": true }
  }
}
